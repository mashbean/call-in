{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "live-deck-kit",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/new", "/new/*", "/en/new", "/en/new/*"]
  },
  "vars": {
    "ROOM_ID": "default",
    "ALLOWED_ORIGINS": "",
    "ADMIN_TOKEN_SHA256": "",
    "MODERATOR_TOKEN_SHA256": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_SESSION",
        "class_name": "LiveSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveSession"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // 正式網域只放在 env.production：Deploy Button 的複製者跑預設環境，不會搶走
  // call-in.mashbean.net。production 必須維持相同 Worker 名稱（live-deck-kit），
  // 才會沿用同一個 Durable Object namespace；改名等同切到一套空白資料。
  "env": {
    "production": {
      "name": "live-deck-kit",
      "vars": {
        "ROOM_ID": "default",
        "ALLOWED_ORIGINS": "",
        "ADMIN_TOKEN_SHA256": "",
        "MODERATOR_TOKEN_SHA256": ""
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "LIVE_SESSION",
            "class_name": "LiveSession"
          }
        ]
      },
      "routes": [
        {
          "pattern": "call-in.mashbean.net",
          "custom_domain": true
        }
      ]
    }
  }
}
