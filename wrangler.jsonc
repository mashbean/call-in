{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "live-deck-kit",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "call-in.mashbean.net",
      "custom_domain": true
    }
  ],
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ROOM_ID": "default",
    "ALLOWED_ORIGINS": "",
    "ADMIN_TOKEN_SHA256": "",
    "MODERATOR_TOKEN_SHA256": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_SESSION",
        "class_name": "LiveSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveSession"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
