{
  "name": "@mashbean/live-deck-kit",
  "version": "0.2.0",
  "description": "Prompt-ready realtime audience interaction for web slide decks",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashbean/live-deck-kit.git"
  },
  "homepage": "https://github.com/mashbean/live-deck-kit#readme",
  "bugs": "https://github.com/mashbean/live-deck-kit/issues",
  "bin": {
    "live-deck-kit": "./scripts/cli.mjs"
  },
  "files": [
    "public",
    "scripts",
    "skills",
    "src",
    "wrangler.jsonc",
    "tsconfig.json",
    "worker-configuration.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run && node --test node-test/uncommon-ground-export.test.mjs",
    "check": "npm run typecheck && npm test && npm run deploy:dry",
    "integrate": "node scripts/cli.mjs integrate",
    "doctor": "node scripts/cli.mjs doctor",
    "admin-token": "node scripts/cli.mjs admin-token",
    "moderator-token": "node scripts/cli.mjs moderator-token",
    "install-skill": "node scripts/cli.mjs install-skill",
    "uncommon-ground": "node scripts/cli.mjs uncommon-ground"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/qrcode": "^1.5.5",
    "devices.css": "^0.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22"
  }
}
