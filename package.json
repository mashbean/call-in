{
  "name": "@mashbean/call-in",
  "version": "0.7.2",
  "description": "Call-in for your slides: prompt-ready realtime audience response",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashbean/call-in.git"
  },
  "homepage": "https://call-in.mashbean.net/",
  "bugs": "https://github.com/mashbean/call-in/issues",
  "bin": {
    "call-in": "./scripts/cli.mjs",
    "live-deck-kit": "./scripts/cli.mjs"
  },
  "files": [
    "public",
    "scripts",
    "skills",
    "src",
    "wrangler.jsonc",
    "tsconfig.json",
    "worker-configuration.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "vendor:pdfjs": "node scripts/vendor-pdfjs.mjs",
    "predev": "npm run vendor:pdfjs",
    "dev": "wrangler dev",
    "predeploy": "npm run vendor:pdfjs",
    "deploy": "wrangler deploy",
    "predeploy:dry": "npm run vendor:pdfjs",
    "deploy:dry": "wrangler deploy --dry-run",
    "prepack": "npm run vendor:pdfjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run && node --test node-test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run deploy:dry",
    "integrate": "node scripts/cli.mjs integrate",
    "doctor": "node scripts/cli.mjs doctor",
    "admin-token": "node scripts/cli.mjs admin-token",
    "moderator-token": "node scripts/cli.mjs moderator-token",
    "install-skill": "node scripts/cli.mjs install-skill",
    "uncommon-ground": "node scripts/cli.mjs uncommon-ground",
    "seed-demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.2.108",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/qrcode": "^1.5.5",
    "devices.css": "^0.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
